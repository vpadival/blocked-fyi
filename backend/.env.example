# Copy to backend/.env. Defaults run offline with explicit fixtures.
PROBE_MODE=auto
MOCK_SCENARIO=regional
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300
PROBE_TIMEOUT_SECONDS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=sqlite:///backend/evidence.sqlite3

# Live mode requires independent, geographically verified proxies with public-only
# IPv4/IPv6 destination ACLs. public_only_egress acknowledges that operator setup.
# Set PROBE_MODE=live and uncomment/configure the following one-line JSON:
# VANTAGE_CONFIG=[{"name":"Node-IN-South","country_code":"IN","domestic":true,"egress_type":"ResidentialProxy","http_proxy_env":"IN_HTTP_PROXY","https_proxy_env":"IN_HTTPS_PROXY","public_only_egress":true},{"name":"Node-US-East","country_code":"US","domestic":false,"egress_type":"DatacenterProxy","http_proxy_env":"US_HTTP_PROXY","https_proxy_env":"US_HTTPS_PROXY","public_only_egress":true},{"name":"Node-EU-Frankfurt","country_code":"DE","domestic":false,"egress_type":"DatacenterProxy","http_proxy_env":"EU_HTTP_PROXY","https_proxy_env":"EU_HTTPS_PROXY","public_only_egress":true}]
# IN_HTTP_PROXY=http://user:password@india-proxy.example:8080
# IN_HTTPS_PROXY=http://user:password@india-proxy.example:8080
# US_HTTP_PROXY=http://user:password@us-proxy.example:8080
# US_HTTPS_PROXY=http://user:password@us-proxy.example:8080
# EU_HTTP_PROXY=http://user:password@eu-proxy.example:8080
# EU_HTTPS_PROXY=http://user:password@eu-proxy.example:8080
# Generic HTTP_PROXY/HTTPS_PROXY can be named for ONE vantage only.
